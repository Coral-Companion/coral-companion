{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "coral-companion-router",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "../frontend/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"containers": [
		{
			"class_name": "BackendCore",
			"image": "../backend/core/Dockerfile",
			"instance_type": {
				"vcpu": 1,
				"memory_mib": 3072,
				"disk_mb": 4000,
			},
			"max_instances": 3,
			"authorized_keys": [
				{
					"name": "key ken",
					"public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPHQt2YI1elj+RGIr1NB1ZLQDnZv1n7TLDrXgE5/KzQw ken.iseli@gmail.com"
				}
			]
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "BackendCore",
				"name": "CORE_CONTAINER"
			}
		]
	},
	"exports": {
		"BackendCore": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"vars": {
		"BUCKET_NAME": "coral-matcher-media",
		"SEGMENTATION_PROVIDER": "fixture",
		"R2_PUBLIC_BASE_URL": "https://media.coralcompanion.earth"
	},
	"secrets": {
		"required": [
			"SUPABASE_KEY",
			"DATABASE_URL",
			"SEGMENTATION_WORKER_URL",
			"MODAL_KEY",
			"MODAL_SECRET",
			"R2_ACCOUNT_ID",
			"R2_ACCESS_KEY_ID",
			"R2_SECRET_ACCESS_KEY",
		]
	},
	"previews": {}
}